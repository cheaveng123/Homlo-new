# Copy to .env and fill in. Never commit .env.

# Application API key (Business Console > API & Webhooks). Sent as the x-api-key header.
DIDIT_API_KEY=

# The webhook destination's secret_shared_key (NOT the API key).
DIDIT_WEBHOOK_SECRET=

# workflow_id of your KYC workflow (OCR + LIVENESS + FACE_MATCH).
# Create it in the Console, or run: npm run create-workflow
DIDIT_WORKFLOW_ID=

# Public base URL of this app (your ngrok https URL). Used to build the callback URL.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# "sandbox" if your API key belongs to a sandbox application (free, mocked results),
# "live" for real checks (uses credits). Only controls whether the UI offers sandbox scenarios.
DIDIT_ENV=sandbox

PORT=3000
