{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["node", "nativewind/types", "geojson"],
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "mnt",
    "supabase/functions",
    "reference",
    "files-3",
    "files-4",
    "files-5",
    "FinderButton.tsx",
    "HomeScreen.tsx",
    "JobCard.tsx",
    "QuickSearchRow.tsx",
    "backend/feed/pangolin_sql_proof.ts",
    "??_*.ts",
    "??_*.tsx",
    "tmp_*.ts",
    "tmp_*.tsx"
  ]
}
