{
  "name": "app-template",
  "version": "1.0.0",
  "private": true,
  "pnpm": {
    "overrides": {
      "proxy-addr": ">=2.0.8",
      "body-parser": ">=1.20.9",
      "qs": ">=6.16.1",
      "follow-redirects": ">=1.16.2"
    },
    "patchedDependencies": {
      "@bam.tech/react-native-image-resizer@3.0.11": "patches/@bam.tech__react-native-image-resizer@3.0.11.patch"
    }
  },
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:metro\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/main.ts",
    "dev:metro": "react-native start --port 8081",
    "build": "esbuild server/_core/main.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/main.js",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "agg:quality": "tsx scripts/run-quality-aggregation.ts",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "qr": "node scripts/generate_qr.mjs",
    "eval:offline": "tsx scripts/run-evaluation.ts",
    "check:release": "node scripts/check-release.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "start_app": "react-native start"
  },
  "dependencies": {
    "@bam.tech/react-native-image-resizer": "^3.0.11",
    "@maplibre/maplibre-react-native": "^10",
    "@ptomasroos/react-native-multi-slider": "^2.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-documents/picker": "^12.1.0",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "11.28.2",
    "@trpc/react-query": "11.28.2",
    "@trpc/server": "11.28.2",
    "clsx": "^2.1.1",
    "compression": "1.8.1",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.3",
    "jose": "6.1.0",
    "maplibre-gl": "^6.5.0",
    "nativewind": "^4.2.1",
    "postgres": "^3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-bootsplash": "^7.4.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-image-picker": "^8.3.0",
    "react-native-keychain": "^10.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "1.27.2",
    "react-native-permissions": "^5.7.0",
    "react-native-purchases": "^11.0.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-video": "^6.19.3",
    "react-native-worklets": "0.10.1",
    "superjson": "^1.13.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.19.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.12.0",
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
