# =============================================================================
# Homlo Jobs — local development environment
# =============================================================================
# This file is gitignored. Copy from .env.example and fill in the placeholders
# marked with FILL_IN_*. Real secrets must NEVER be committed.
#
# How the app actually authenticates locally:
#   - Mobile/web client  -> Homlo Express server (/api/supabase-auth/*)
#   - Homlo server       -> Supabase (Auth + Postgres) using the service-role key
#   - Drizzle migrations -> Postgres via SUPABASE_DB_URL
#
# JWT_SECRET is intentionally NOT required. Homlo uses Supabase Auth as the
# single authentication provider; sessions are stored as Supabase access and
# refresh tokens, not as locally-signed JWTs.
# =============================================================================

# --- API base URL (optional) -------------------------------------------------
# On Expo Go / a physical device, the app derives the API URL from
# Constants.expoConfig.hostUri (swapping Metro's :8081 for the API's :3000),
# so the default works as long as the phone and dev machine are on the same LAN.
# Set this to override that derivation in any environment:
#   - Web on a remote host that doesn't follow the 8081-*/8081:3000 pattern
#   - EAS / production builds
#   - Local testing with a hardcoded LAN IP (e.g. http://192.168.1.42:3000)
# EXPO_PUBLIC_API_BASE_URL=

# --- Runtime environment and payment verification -----------------------------
# APP_ENV must be explicitly set. If omitted, the server treats itself as
# production and refuses payment activation. Use "development" only locally.
APP_ENV=development

# "simulated" is allowed only when APP_ENV=development. In production, set this
# to "webhook" and configure a signed provider callback before enabling payments.
HOMLO_PAYMENT_VERIFICATION_MODE=simulated
# With both of the above, a successful RevenueCat Test Store purchase activates
# the boost directly (no secret key or webhook needed). Real stores still need
# REVENUECAT_SECRET_API_KEY / the webhook below.

# --- CORS allowlist ------------------------------------------------------------
# Comma-separated list of exact browser origins allowed to call the API with
# credentials (scheme + host + optional port, no trailing slash).
# Example: ALLOWED_ORIGINS=https://app.homlo.com,https://admin.homlo.com
# localhost origins are automatically allowed only when NODE_ENV is not
# "production". Native mobile requests (x-homlo-client: native) send no Origin
# and are not affected by CORS. REQUIRED in production for the web frontend.
ALLOWED_ORIGINS=

# --- Supabase (server-side, real secrets) -------------------------------------
# Project URL from Supabase dashboard: Project Settings -> API -> Project URL
# Example shape: https://abcdefghijkl.supabase.co
SUPABASE_URL=FILL_IN_SUPABASE_URL

# Service-role key from Supabase dashboard: Project Settings -> API -> service_role
# This key bypasses Row Level Security. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=FILL_IN_SUPABASE_SERVICE_ROLE_KEY

# Transactional Postgres connection string from Supabase dashboard:
# Project Settings -> Database -> Connection string -> "Transaction pooler"
# Example shape: postgres://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=FILL_IN_SUPABASE_DB_URL

# Optional client-safe key. Only used as metadata on the server; the Expo
# client does not need it. Safe to leave blank for local dev.
# SUPABASE_ANON_KEY=

# --- Client Supabase (Realtime) -----------------------------------------------
# The anon key is public and safe to embed in the client app. Required for
# Supabase Realtime (live messaging). Set to the same Supabase project's
# anon key. Safe to leave blank for local dev (Realtime falls back to polling).
EXPO_PUBLIC_SUPABASE_URL=FILL_IN_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=FILL_IN_SUPABASE_ANON_KEY

# --- RevenueCat boost purchases ------------------------------------------------
# RevenueCat Test Store public SDK key: RevenueCat dashboard -> Project settings
# -> API keys -> Public app-specific key (Test Store). A key beginning with
# test_ MUST NOT ship in a production build.
EXPO_PUBLIC_RC_TEST_KEY=test_hxVUxQrNjseVOGhFHBYFKDnDyud

# Optional live iOS public key: RevenueCat dashboard -> Project settings ->
# API keys -> Apple App Store public key. Takes precedence over the test key.
EXPO_PUBLIC_RC_IOS_KEY=

# Optional live Android public key: RevenueCat dashboard -> Project settings ->
# API keys -> Google Play public key. Takes precedence over the test key.
EXPO_PUBLIC_RC_ANDROID_KEY=

# Webhook shared secret: generate with `openssl rand -hex 32`; paste the same
# value into RevenueCat -> Integrations -> Webhooks -> Authorization header.
# If missing or still the placeholder, the webhook is disabled (503).
REVENUECAT_WEBHOOK_AUTH=PASTE_A_LONG_RANDOM_VALUE_HERE

# --- Map / geocoding / routing (all optional, client-safe) --------------------
# Defaults point at the public OpenStreetMap ecosystem:
#   tiles   -> https://tile.openstreetmap.org/{z}/{x}/{y}.png
#   style   -> https://tiles.openfreemap.org/styles/liberty
#   geocode -> https://nominatim.openstreetmap.org
#   routing -> https://router.project-osrm.org
# Override these for production/self-hosted infrastructure. Never point a
# physical device at localhost: use a LAN IP or a public HTTPS endpoint.
# EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
# EXPO_PUBLIC_MAP_MAX_ZOOM=19
# EXPO_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
# EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org
# EXPO_PUBLIC_ROUTE_PROFILE=driving
# EXPO_PUBLIC_ROUTE_TIMEOUT_MS=8000
# EXPO_PUBLIC_GEOCODING_TIMEOUT_MS=8000

# --- Native MapLibre + OpenRouteService (react-native-config) ------------------
# Read by the native app at build time. Rebuild after changing these values.
# Use the same keys for web exports by setting the matching EXPO_PUBLIC_* vars.
MAPTILER_KEY=FILL_IN_MAPTILER_KEY
ORS_API_KEY=FILL_IN_ORS_API_KEY
# EXPO_PUBLIC_MAPTILER_KEY=FILL_IN_MAPTILER_KEY
# EXPO_PUBLIC_ORS_API_KEY=FILL_IN_ORS_API_KEY

# --- Reverse proxy / real client IP ------------------------------------------
# Number of reverse proxies in front of this Express server. Defaults to 0,
# which means X-Forwarded-For is ignored and the direct socket IP is used.
# Set to 1 for Render/Railway/Fly/Heroku once deployed.
# Set to 2 only if two proxies exist (e.g. Cloudflare in front of the platform).
# TRUST_PROXY_HOPS=0

# --- Server listen port (optional) --------------------------------------------
# Defaults to 3000. Only override if 3000 is unavailable on this machine.
# PORT=3000

# --- Event logging (optional) ------------------------------------------------
# Salt used to hash request IP addresses stored in job_events.ip_hash (SHA-256).
# Set a long random value in production so the hash can't be brute-forced; a
# fixed fallback is used when unset. Raw IPs are never stored or logged.
# HOMLO_EVENT_IP_HASH_SALT=FILL_IN_LONG_RANDOM_IP_HASH_SALT

# --- Node environment (optional) ---------------------------------------------
# Set automatically by `pnpm dev:server` to "development". Leave unset otherwise.
# NODE_ENV=development

# RevenueCat SECRET API key (sk_...) — lets the server confirm boost purchases
# instantly instead of waiting for the webhook. Server-only: never EXPO_PUBLIC_.
REVENUECAT_SECRET_API_KEY=PASTE_YOUR_REVENUECAT_SECRET_KEY_HERE

# --- App Store release settings (checked by `npm run check:release`) ---
# EXPO_PUBLIC_API_BASE_URL (above) must be set: a public https hostname, never an IP address or localhost.
# Shown as Profile → Contact support.
EXPO_PUBLIC_SUPPORT_EMAIL=
# Sample employers/jobs/reviews for local design work only. Never "true" in a store build.
EXPO_PUBLIC_DEMO_CONTENT=false

# --- Trust & safety (server/trust, 057_trust_safety.sql) ----------------------
# Encrypts IP address / user agent in consent_log (AES-256-GCM). REQUIRED in
# production (32+ chars): openssl rand -hex 32. Never change it after launch
# without re-encrypting, or old consent records become unreadable.
# FIELD_ENCRYPTION_KEY=
# Keyed hash for ban matching (email, phone, device, IP). REQUIRED in production.
# HOMLO_IDENTIFIER_HASH_SECRET=
# Public base URL used in the email confirmation link (defaults to EXPO_PUBLIC_API_BASE_URL).
# HOMLO_PUBLIC_BASE_URL=https://api.example.com
# Email: "log" (default, dev only: prints emails) or "resend". OWNER DECISION + account.
# EMAIL_PROVIDER=log
# RESEND_API_KEY=
# EMAIL_FROM="Homlo <no-reply@example.com>"
# SMS codes: "log" (default, dev only: prints codes) or "twilio". OWNER DECISION + account.
# SMS_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Set to true to stop listing expiry / emails / retention running in this process.
# HOMLO_DISABLE_TRUST_SWEEPER=false
